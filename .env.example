# Copia este archivo como .env (no se sube a git). En desarrollo no hace falta nada de esto:
# sin DATABASE_URL se usa PGlite (un Postgres embebido en server/data/pglite) y cuentas locales.
PORT=3000

# ── Supabase (datos + cuentas). Las cuatro van juntas; si pones SUPABASE_URL faltando alguna, el servidor no arranca. ──
# Project Settings → API:
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_ANON_KEY=la clave «anon» (pública)
# SUPABASE_SERVICE_KEY=la clave «service_role» (SECRETA: nunca en el cliente ni en el chat)
# Connect → «Session pooler» (no el «Transaction pooler»), con tu contraseña de la base:
# DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
# Esquema donde viven las tablas (por defecto «parkspotter»; no se mezcla con otras apps del proyecto).
# DB_SCHEMA=parkspotter

# ── Correo saliente: códigos de verificación y «olvidé mi contraseña» ──
# Con SMTP_HOST puesto, las cuentas nuevas deben confirmar su correo con un código de 6 dígitos. Sin él no se envía nada
# y las cuentas entran directo. Ejemplo con Gmail (necesita verificación en 2 pasos y una «contraseña de aplicación»):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=la contraseña de aplicación de 16 letras (NO la de tu cuenta)
# SMTP_FROM=ParkSpotter <tucorreo@gmail.com>
# VERIFICAR_CORREO=0   # pone «0» para NO exigir verificación aunque haya SMTP (sigue sirviendo «olvidé mi contraseña»)

# Asistente con modelo de lenguaje (opcional; sin esto usa su intérprete local). Cualquier API «chat/completions».
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=

# Muestra los botones «Conductor / Propietario» de demostración en el ingreso.
# DEMO=1

# Carpeta de las fotos subidas (por defecto server/data/uploads).
# UPLOADS_DIR=

# Obligatorio en producción: una cadena larga y aleatoria (firma las sesiones).
# JWT_SECRET=

# Solo para `npm run db:seed`: contraseña del administrador de demostración.
# ADMIN_PASSWORD=
